---
// TYO Sound — Events landing page
// A dedicated landing page for live-event work (built from a design brief
// the client had Claude Design put together). Reuses the same shared
// components/tokens as the rest of the site rather than one-off styling,
// so it stays visually consistent with the home/equipment pages.
//
// Linked from the shared NavHeader as "Live Events" (added at the client's
// request, after originally being kept out of the nav as a standalone
// landing page).
import '../styles/styles.css';
import NavHeader from '../components/NavHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import TextLink from '../components/TextLink.astro';
import ServiceColumn from '../components/ServiceColumn.astro';
import FeaturedWorkItem from '../components/FeaturedWorkItem.astro';
import TrustBar from '../components/TrustBar.astro';
import SEOHead from '../components/SEOHead.astro';
import projectsData from '../data/projects.json';

// Normalized to strip a trailing slash -- BASE_URL is '/tyosound' in
// preview (no trailing slash) but '/' at the real domain (trailing
// slash), and every ${base}/path template below assumes the former;
// left un-normalized, base:'/' produces broken '//path' double slashes.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const eventProjects = projectsData.projects
  .filter((p) => p.cat === 'events')
  .sort((a, b) => a.sortingOrder - b.sortingOrder);

// PLACEHOLDER COPY -- these 3 cards are cosmetic-only per the design brief
// ("interactive state, only cosmetic here"): selecting one just toggles
// visual state, nothing below is filtered. Real service names/descriptions
// still need client review, same as the original home-page Events column
// was before it got real language.
const offerings = [
  {
    index: 1,
    title: 'Sound Reinforcement',
    cat: 'sound',
    body: 'PA systems, wireless mics, and live engineering.',
  },
  {
    index: 2,
    title: 'Multi Camera Capture',
    cat: 'broadcast',
    body: 'Camera setups designed to get the best moments onstage and off.',
  },
  {
    index: 3,
    title: 'Editing and Post',
    cat: 'production',
    body: 'Sync, color, and edit your event into a polished video ready for your website or socials.',
  },
];

// Clients for the scrolling strip, in the client's order. Blue Cross Blue
// Shield and CareFirst have no src: no usable logo file was available, so
// TrustBar shows their names as type-set wordmarks until real logo files
// are supplied (add `src: `${base}/img/logos/<file>`` to swap one in).
const eventClients = [
  { name: 'Blue Cross Blue Shield' },
  { name: 'Spotify', src: `${base}/img/logos/spotify.svg`, scale: 1.15 },
  { name: 'Monumental Sports', src: `${base}/img/logos/monumental-sports.png`, scale: 2 },
  { name: 'More Perfect Union', src: `${base}/img/logos/more-perfect-union.svg`, scale: 1.4 },
  { name: 'CareFirst' },
  { name: 'Stand Together', src: `${base}/img/logos/stand-together.webp`, scale: 2.3 },
];

const description = 'Live event audio and video production from TYO Sound — sound reinforcement, broadcast, and streaming for panels, conferences, and performances in Washington, D.C. and Baltimore.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEOHead title="Live Event Audio + Video — TYO Sound" description={description} ogImage={`${base}/img/hero-dc-capitol.jpg`} />
    <link rel="preconnect" href="https://player.vimeo.com" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- HERO -->
    <section class="hero" id="main">
      <img class="hero-photo" src={`${base}/img/hero-dc-capitol.jpg`} alt="Washington, D.C. streetscape near the U.S. Capitol" />
      <div class="hero-scrim"></div>
      <div class="hero-header"><NavHeader theme="onPhoto" active="Live Events" /></div>
      <div class="hero-content">
        <Eyebrow onLight={false} class="hero-eyebrow">Washington D.C. + Baltimore</Eyebrow>
        <h1 class="hero-title">Live Events</h1>
        <p class="hero-body">Sound reinforcement and multi-cam recording for panels, conferences, and performances.</p>
        <div class="hero-ctas">
          <Button href="#services" variant="solid" onLight={false}>See past events</Button>
          <TextLink href="#contact" onLight={false}>Book a call</TextLink>
        </div>
      </div>
    </section>

    <!-- WHAT WE OFFER -->
    <section class="offerings" id="services">
      <div class="content">
        <Eyebrow onLight={false} muted>What we do</Eyebrow>
        <div class="offering-cols" data-evt-cards>
          {offerings.map((o) => (
            <ServiceColumn index={o.index} title={o.title} body={o.body} cat={o.cat} selected={o.index === 1} showCue={false} />
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURED WORK -->
    <section class="featured-work" id="featured-work">
      <div class="content">
        <div class="fw-header">
          <Eyebrow muted>Featured Work</Eyebrow>
          <h2 class="section-title">Past Events</h2>
        </div>
        <div data-fw-list>
          {eventProjects.map((p) => (
            <FeaturedWorkItem
              id={p.id}
              title={p.title}
              client={p.client}
              role={p.role}
              cat={p.cat}
              youtubeId={p.youtubeId}
              startSeconds={p.startSeconds}
              vimeoId={p.vimeoId}
              vimeoHash={p.vimeoHash}
              jwId={p.jwId}
              images={p.images?.map((img) =>
                typeof img === 'string' ? `${base}${img}` : { ...img, src: `${base}${img.src}` }
              )}
              credit={p.credit}
              imageFit={p.imageFit}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="clients">
      <div class="content">
        <TrustBar label="Clients Include" onLight={true} clients={eventClients} copies={4} duration={20} eager />
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="content cta-inner">
        <Eyebrow onLight={false} muted>Ready when you are</Eyebrow>
        <h2 class="section-title">Let's Talk About Your Event</h2>
        <p class="cta-body">Tell us what you're planning and we'll put together the right setup for your sound and video needs.</p>
      </div>
    </section>

    <SiteFooter />

    <script>
      // Cosmetic-only select state for the offering cards -- no filtering
      // wired to Featured Work below (see PLACEHOLDER COPY comment above).
      const wrap = document.querySelector('[data-evt-cards]');
      if (wrap) {
        const cols = [...wrap.querySelectorAll('[data-service-col]')];
        cols.forEach((c) => {
          c.querySelector('.col-select')?.addEventListener('click', () => {
            cols.forEach((other) => other.setAttribute('data-selected', String(other === c)));
          });
        });
      }
    </script>

    <script>
      // Single-open accordion for the Featured Work list -- same
      // height-based expand/collapse as the home page's Featured Work,
      // minus the service-filter wiring (this page only ever shows the
      // Events rows, so there's nothing to filter).
      const listWrap = document.querySelector('[data-fw-list]');
      if (listWrap) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const rows = [...listWrap.querySelectorAll('[data-work-item]')];

        function setOpen(row, open) {
          row.setAttribute('data-open', String(open));
          const expand = row.querySelector('.expand');
          const iframe = row.querySelector('iframe[data-video-src]');
          const btn = row.querySelector('[data-work-toggle]');
          if (btn) btn.setAttribute('aria-expanded', String(open));
          if (expand) {
            expand.style.height = open ? expand.scrollHeight + 'px' : '0px';
          }
          if (iframe) {
            if (open) {
              iframe.style.opacity = '0';
              iframe.onload = () => { iframe.style.opacity = '1'; };
              iframe.src = iframe.dataset.videoSrc;
            } else {
              iframe.onload = null;
              iframe.removeAttribute('src');
              iframe.style.opacity = '0';
            }
          }
        }

        rows.forEach((r) => {
          const btn = r.querySelector('[data-work-toggle]');
          btn?.addEventListener('click', () => {
            const isOpen = r.dataset.open === 'true';
            rows.forEach((other) => other !== r && setOpen(other, false));
            setOpen(r, !isOpen);
            if (!isOpen) {
              // Wait for the expand transition (--dur-slow, 480ms) so the
              // scroll target accounts for the row's final expanded height.
              setTimeout(() => {
                r.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
              }, 500);
            }
          });
        });
      }
    </script>

    <style>
      :global(html) { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) {
        :global(html) { scroll-behavior: auto; }
      }
      body { margin: 0; font-family: var(--font-sans); background: var(--bg-page); }
      .content { max-width: var(--content-max); margin: 0 auto; padding: 0 var(--page-gutter); }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--white);
        color: var(--black);
        padding: var(--space-3) var(--space-5);
        font-family: var(--font-sans);
        font-weight: var(--weight-medium);
        text-transform: uppercase;
        letter-spacing: var(--tracking-wide);
      }
      .skip-link:focus { left: var(--space-4); top: var(--space-4); }

      /* HERO */
      .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
      .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .hero-scrim { position: absolute; inset: 0; background: var(--scrim-hero); }
      .hero-header { position: relative; z-index: 2; }
      .hero-content {
        position: relative; z-index: 2; margin-top: auto;
        max-width: var(--content-max); margin-inline: auto; width: 100%;
        padding: 0 var(--page-gutter) var(--space-9);
        color: var(--white);
      }
      .hero-title {
        margin: var(--space-4) 0 var(--space-5);
        font-weight: var(--weight-bold);
        text-transform: uppercase;
        font-size: var(--text-hero);
        line-height: var(--leading-tight);
        letter-spacing: var(--tracking-tight);
        max-width: 20ch;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7), 0 4px 20px rgba(0, 0, 0, 0.55);
      }
      .hero-body {
        max-width: 42ch;
        margin: 0 0 var(--space-6);
        font-size: var(--text-lg);
        line-height: var(--leading-normal);
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.75), 0 2px 10px rgba(0, 0, 0, 0.55);
      }
      :global(.hero-eyebrow) { text-shadow: 0 1px 3px rgba(0, 0, 0, 0.75), 0 2px 10px rgba(0, 0, 0, 0.55); }
      .hero-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); }

      /* Shared display-headline treatment for the three lower sections */
      .section-title {
        margin: var(--space-3) 0 0;
        font-weight: var(--weight-bold);
        text-transform: uppercase;
        font-size: var(--text-display);
        line-height: var(--leading-tight);
        letter-spacing: var(--tracking-tight);
      }

      /* WHAT WE OFFER */
      /* Matches the home page's What We Do section: small muted label above
         the cards, and the same tighter top/bottom padding (that page uses
         clamp(32px, 4vw, 64px) rather than the larger --section-pad-y). */
      .offerings { background: var(--bg-inverse); color: var(--white); padding: clamp(32px, 4vw, 64px) 0; }
      .offering-cols {
        margin-top: var(--space-6);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: clamp(24px, 4vw, 56px);
      }
      @media (max-width: 760px) {
        .offering-cols { grid-template-columns: 1fr; gap: var(--space-6); }
      }

      /* FEATURED WORK */
      .featured-work { background: var(--bg-muted); padding: var(--section-pad-y) 0; }
      .fw-header { margin-bottom: var(--space-5); }

      /* CLIENTS -- white so it separates the gray Featured Work above from
         the dark CTA/footer below; tighter padding than the big sections
         since it's a single-line strip. */
      .clients { background: var(--white); padding: var(--space-8) 0; }

      /* CTA -- shares the footer's dark background and left alignment with
         no padding-bottom of its own, so the two flow as one unbroken
         section (the footer's own padding-top supplies the gap above
         "Let's Chat") instead of reading as two separate blocks. */
      .cta { background: var(--bg-inverse); padding: var(--section-pad-y) 0 0; }
      .cta-inner { color: var(--white); }
      .cta-body {
        max-width: 46ch;
        margin: var(--space-5) 0 0;
        font-size: var(--text-lg);
        color: rgba(255, 255, 255, 0.7);
      }

      /* FOOTER (this page only) -- SiteFooter is shared across every page,
         so this is a scoped override rather than an edit to the component
         itself. Dropping the "Let's Chat" heading lets the form sit flush
         with the top of the grid row, level with the TYO Sound column
         beside it, instead of starting lower than it. */
      :global(.footer .heading) { display: none; }

      @media (max-width: 640px) {
        .hero-ctas { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
      }
    </style>
  </body>
</html>
